{
  "name": "@denkschuldt/react-dialog",
  "version": "1.0.4",
  "private": false,
  "description": "A simple to use and customizable react dialog implementation.",
  "main": "./dist/index.cjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenkSchuldt/react-dialog.git"
  },
  "keywords": [
    "React",
    "Dialog",
    "Modal",
    "react-dialog",
    "react-modal",
    "React dialog",
    "React modal"
  ],
  "authors": [
    "Denny K. Schuldt (https://github.com/DenkSchuldt)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DenkSchuldt/react-dialog/issues"
  },
  "homepage": "https://denkschuldt.github.io/react-dialog",
  "dependencies": {
    "prop-types": "15.8.1",
    "react-draggable": "4.7.2"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "start": "vite build --watch",
    "build": "vite build && node scripts/copy-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/test-package.mjs",
    "test:e2e": "playwright test",
    "dev": "npm run dev --workspace examples",
    "build:demo": "npm run build --workspace examples",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package && npm run build:demo && npm run build-storybook",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.1",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.3"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.node.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "workspaces": [
    "examples"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.0"
}
